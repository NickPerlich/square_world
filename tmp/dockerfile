FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /root

# 1. Install Ubuntu desktop components, noVNC, MariaDB, and Java runtime
RUN apt-get update && apt-get install -y \
    xfce4 xfce4-goodies \
    x11vnc xvfb novnc websockify \
    mariadb-server mariadb-client \
    wget curl net-tools \
    openjdk-17-jre && \
    rm -rf /var/lib/apt/lists/*

# 2. Configure MariaDB (create DB)
RUN service mariadb start && \
    mysql -u root -e "CREATE DATABASE demo;" && \
    mysqladmin -u root password ''

# 3. Copy your Java shaded JAR
COPY multiverse-1.0-SNAPSHOT-shaded.jar /root/app.jar

# 4. Copy startup script
COPY start.sh /root/start.sh
RUN chmod +x /root/start.sh

# 5. Expose noVNC and MariaDB ports
EXPOSE 6080 3306

# 6. Run everything
CMD ["/root/start.sh"]
